# Minimal demo configuration.
# Most values have safe defaults in the scripts/code. Usually you only need to edit
# VLLM_PYTHON, VLLM_MODEL_PATH, VLLM_PORT/VLLM_BASE_URL and VLLM_DTYPE.

# FastAPI service
SERVICE_PORT=8088

# Ghidra
GHIDRA_ANALYZE_HEADLESS=./ghidra/ghidra_11.0.3_PUBLIC/support/analyzeHeadless
GHIDRA_POSTSCRIPT=./ghidra/decompile.py

# vLLM client used by FastAPI
VLLM_BASE_URL=http://127.0.0.1:8001/v1
VLLM_MODEL=llm4decompile

# vLLM server
# Leave empty if you run run_vllm.sh inside the conda env that has vLLM installed.
# Example: /home/feng/miniconda3/envs/llm4decompile/bin/python
VLLM_PYTHON=
VLLM_MODEL_PATH=./models/llm4decompile-1.3b-v2
VLLM_PORT=8001
VLLM_DTYPE=half

# Optional common tuning
VLLM_CUDA_VISIBLE_DEVICES=
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_TOKENS=4048

# Fallback to Ghidra raw when vLLM fails
FALLBACK_TO_GHIDRA_RAW=true

# Max uploaded binary size in bytes (default 500 MiB)
MAX_BINARY_SIZE_BYTES=524288000
